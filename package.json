{
  "name": "aks-framework",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/cli",
    "packages/driver-postgres"
  ],
  "description": "AKS Framework - TypeScript-first Node.js framework",
  "scripts": {
  "build": "npm run build:core && npm run build:cli && npm run build:driver-postgres",
  "build:core": "tsc -p packages/core/tsconfig.json",
  "build:cli": "tsc -p packages/cli/tsconfig.json",
  "build:driver-postgres": "tsc -p packages/driver-postgres/tsconfig.json",
  "test": "vitest run --pool=threads --maxWorkers=1 --no-file-parallelism",
  "test:watch": "vitest",
  "test:postgres": "vitest run packages/driver-postgres/tests/live-postgres.test.ts",
  "dev": "tsx examples/hello-api.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@aks-framework/cli": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
